================================================================================
4. Auth 과정에서 키 연산을 호출하는 로직
================================================================================

파일: hostap/src/common/sae.c

4.1. SAE Commit 처리 함수 (키 연산 시작점)
함수: sae_process_commit()
위치: sae.c:1670-1684
설명: SAE Commit 메시지를 처리하고 키를 도출하는 함수

매개변수:
- sae: struct sae_data * - SAE 데이터 구조체

반환값:
- int - 성공 시 0, 실패 시 -1

주요 로직:
```1670:1684:hostap/src/common/sae.c
int sae_process_commit(struct sae_data *sae)
{
	u8 k[SAE_MAX_PRIME_LEN];
	int ret = 0;

	if (sae->tmp == NULL ||
	    (sae->tmp->ec && sae_derive_k_ecc(sae, k) < 0) ||
	    (sae->tmp->dh && sae_derive_k_ffc(sae, k) < 0) ||
	    sae_derive_keys(sae, k) < 0)
		ret = -1;

	forced_memzero(k, SAE_MAX_PRIME_LEN);

	return ret;
}
```

상수:
- SAE_MAX_PRIME_LEN: 최대 Prime 길이 (512)

4.2. ECC 기반 키 도출 함수
함수: sae_derive_k_ecc()
위치: sae.c:1433-1466
설명: ECC (Elliptic Curve Cryptography) 기반으로 k 값을 도출하는 함수

매개변수:
- sae: struct sae_data * - SAE 데이터 구조체
- k: u8 * - 도출된 k 값을 저장할 버퍼

반환값:
- int - 성공 시 0, 실패 시 -1

주요 로직:
```1433:1466:hostap/src/common/sae.c
static int sae_derive_k_ecc(struct sae_data *sae, u8 *k)
{
	struct crypto_ec_point *K;
	int ret = -1;

	K = crypto_ec_point_init(sae->tmp->ec);
	if (K == NULL)
		goto fail;

	/*
	 * K = scalar-op(rand, (elem-op(scalar-op(peer-commit-scalar, PWE),
	 *                                        PEER-COMMIT-ELEMENT)))
	 * If K is identity element (point-at-infinity), reject
	 * k = F(K) (= x coordinate)
	 */

	if (crypto_ec_point_mul(sae->tmp->ec, sae->tmp->pwe_ecc,
				sae->peer_commit_scalar, K) < 0 ||
	    crypto_ec_point_add(sae->tmp->ec, K,
				sae->tmp->peer_commit_element_ecc, K) < 0 ||
	    crypto_ec_point_mul(sae->tmp->ec, K, sae->tmp->sae_rand, K) < 0 ||
	    crypto_ec_point_is_at_infinity(sae->tmp->ec, K) ||
	    crypto_ec_point_to_bin(sae->tmp->ec, K, k, NULL) < 0) {
		wpa_printf(MSG_DEBUG, "SAE: Failed to calculate K and k");
		goto fail;
	}

	wpa_hexdump_key(MSG_DEBUG, "SAE: k", k, sae->tmp->prime_len);

	ret = 0;
fail:
	crypto_ec_point_deinit(K, 1);
	return ret;
}
```

4.3. FFC 기반 키 도출 함수
함수: sae_derive_k_ffc()
위치: sae.c:1469-1504
설명: FFC (Finite Field Cryptography) 기반으로 k 값을 도출하는 함수

매개변수:
- sae: struct sae_data * - SAE 데이터 구조체
- k: u8 * - 도출된 k 값을 저장할 버퍼

반환값:
- int - 성공 시 0, 실패 시 -1

주요 로직:
```1469:1504:hostap/src/common/sae.c
static int sae_derive_k_ffc(struct sae_data *sae, u8 *k)
{
	struct crypto_bignum *K;
	int ret = -1;

	K = crypto_bignum_init();
	if (K == NULL)
		goto fail;

	/*
	 * K = scalar-op(rand, (elem-op(scalar-op(peer-commit-scalar, PWE),
	 *                                        PEER-COMMIT-ELEMENT)))
	 * If K is identity element (one), reject.
	 * k = F(K) (= x coordinate)
	 */

	if (crypto_bignum_exptmod(sae->tmp->pwe_ffc, sae->peer_commit_scalar,
				  sae->tmp->prime, K) < 0 ||
	    crypto_bignum_mulmod(K, sae->tmp->peer_commit_element_ffc,
				 sae->tmp->prime, K) < 0 ||
	    crypto_bignum_exptmod(K, sae->tmp->sae_rand, sae->tmp->prime, K) < 0
	    ||
	    crypto_bignum_is_one(K) ||
	    crypto_bignum_to_bin(K, k, SAE_MAX_PRIME_LEN, sae->tmp->prime_len) <
	    0) {
		wpa_printf(MSG_DEBUG, "SAE: Failed to calculate K and k");
		goto fail;
	}

	wpa_hexdump_key(MSG_DEBUG, "SAE: k", k, sae->tmp->prime_len);

	ret = 0;
fail:
	crypto_bignum_deinit(K, 1);
	return ret;
}
```

4.4. 키 도출 함수 (KCK, PMK, PMKID)
함수: sae_derive_keys()
위치: sae.c:1528-1667
설명: k 값으로부터 KCK, PMK, PMKID를 도출하는 함수

매개변수:
- sae: struct sae_data * - SAE 데이터 구조체
- k: const u8 * - 도출된 k 값

반환값:
- int - 성공 시 0, 실패 시 -1

상수:
- SAE_MAX_HASH_LEN: 최대 해시 길이 (64)
- SAE_MAX_PRIME_LEN: 최대 Prime 길이 (512)
- SAE_PMK_LEN: PMK 길이 (32)
- SAE_PMK_LEN_MAX: 최대 PMK 길이 (64)
- SAE_PMKID_LEN: PMKID 길이 (16)
- SHA256_MAC_LEN: SHA256 MAC 길이 (32)

주요 로직:
```1528:1667:hostap/src/common/sae.c
static int sae_derive_keys(struct sae_data *sae, const u8 *k)
{
	u8 zero[SAE_MAX_HASH_LEN], val[SAE_MAX_PRIME_LEN];
	const u8 *salt;
	struct wpabuf *rejected_groups = NULL;
	u8 keyseed[SAE_MAX_HASH_LEN];
	u8 keys[2 * SAE_MAX_HASH_LEN + SAE_PMK_LEN_MAX];
	struct crypto_bignum *tmp;
	int ret = -1;
	size_t hash_len, salt_len, prime_len = sae->tmp->prime_len;
	size_t pmk_len;
	const u8 *addr[1];
	size_t len[1];

	tmp = crypto_bignum_init();
	if (tmp == NULL)
		goto fail;

	/* keyseed = H(salt, k)
	 * KCK || PMK = KDF-Hash-Length(keyseed, "SAE KCK and PMK",
	 *                      (commit-scalar + peer-commit-scalar) modulo r)
	 * PMKID = L((commit-scalar + peer-commit-scalar) modulo r, 0, 128)
	 */

	// ... 해시 길이 결정 ...
	if (!sae->h2e)
		hash_len = SHA256_MAC_LEN;
	else if (sae->tmp->dh)
		hash_len = sae_ffc_prime_len_2_hash_len(prime_len);
	else
		hash_len = sae_ecc_prime_len_2_hash_len(prime_len);

	// ... salt 설정 (H2E의 경우 rejected groups 사용) ...
	// ... keyseed 도출 (HKDF Extract) ...
	if (hkdf_extract(hash_len, salt, salt_len, 1, addr, len, keyseed) < 0)
		goto fail;

	// ... (commit-scalar + peer-commit-scalar) mod r 계산 ...
	if (crypto_bignum_add(sae->tmp->own_commit_scalar,
			      sae->peer_commit_scalar, tmp) < 0 ||
	    crypto_bignum_mod(tmp, sae->tmp->order, tmp) < 0)
		goto fail;

	// ... KCK, PMK 도출 (KDF) ...
	if (sae_kdf_hash(hash_len, keyseed, "SAE KCK and PMK",
			 val, sae->tmp->order_len,
			 keys, hash_len + pmk_len) < 0)
		goto fail;

	// ... 키 저장 ...
	os_memcpy(sae->tmp->kck, keys, hash_len);
	sae->tmp->kck_len = hash_len;
	os_memcpy(sae->pmk, keys + hash_len, pmk_len);
	sae->pmk_len = pmk_len;
	os_memcpy(sae->pmkid, val, SAE_PMKID_LEN);

	ret = 0;
fail:
	wpabuf_free(rejected_groups);
	crypto_bignum_deinit(tmp, 0);
	return ret;
}
```

4.5. KDF 해시 함수
함수: sae_kdf_hash()
위치: sae.c:1507-1525
설명: SAE 키 도출을 위한 해시 함수 (PRF)

매개변수:
- hash_len: size_t - 해시 길이
- k: const u8 * - 입력 키
- label: const char * - 레이블 ("SAE KCK and PMK" 등)
- context: const u8 * - 컨텍스트 데이터
- context_len: size_t - 컨텍스트 데이터 길이
- out: u8 * - 출력 버퍼
- out_len: size_t - 출력 길이

반환값:
- int - 성공 시 0, 실패 시 -1

주요 로직:
```1507:1525:hostap/src/common/sae.c
static int sae_kdf_hash(size_t hash_len, const u8 *k, const char *label,
			const u8 *context, size_t context_len,
			u8 *out, size_t out_len)
{
	if (hash_len == 32)
		return sha256_prf(k, hash_len, label,
				  context, context_len, out, out_len);
#ifdef CONFIG_SHA384
	if (hash_len == 48)
		return sha384_prf(k, hash_len, label,
				  context, context_len, out, out_len);
#endif /* CONFIG_SHA384 */
#ifdef CONFIG_SHA512
	if (hash_len == 64)
		return sha512_prf(k, hash_len, label,
				  context, context_len, out, out_len);
#endif /* CONFIG_SHA512 */
	return -1;
}
```

================================================================================
5. EAPOL 과정이 시작되는 로직
================================================================================

파일: hostap/src/ap/wpa_auth.c

5.1. STA Association 후 EAPOL 시작 함수
함수: wpa_auth_sta_associated()
위치: wpa_auth.c:1037-1087
설명: STA이 Association된 후 EAPOL 인증을 시작하는 함수

매개변수:
- wpa_auth: struct wpa_authenticator * - WPA 인증 구조체
- sm: struct wpa_state_machine * - WPA 상태 머신

반환값:
- int - 성공 시 0, 실패 시 -1

주요 로직:
```1037:1087:hostap/src/ap/wpa_auth.c
int wpa_auth_sta_associated(struct wpa_authenticator *wpa_auth,
			    struct wpa_state_machine *sm)
{
	if (!wpa_auth || !wpa_auth->conf.wpa || !sm)
		return -1;

#ifdef CONFIG_IEEE80211R_AP
	if (sm->ft_completed) {
		wpa_auth_logger(wpa_auth, wpa_auth_get_spa(sm), LOGGER_DEBUG,
				"FT authentication already completed - do not start 4-way handshake");
		/* Go to PTKINITDONE state to allow GTK rekeying */
		sm->wpa_ptk_state = WPA_PTK_PTKINITDONE;
		sm->Pair = true;
		return 0;
	}
#endif /* CONFIG_IEEE80211R_AP */

#ifdef CONFIG_FILS
	if (sm->fils_completed) {
		wpa_auth_logger(wpa_auth, wpa_auth_get_spa(sm), LOGGER_DEBUG,
				"FILS authentication already completed - do not start 4-way handshake");
		/* Go to PTKINITDONE state to allow GTK rekeying */
		sm->wpa_ptk_state = WPA_PTK_PTKINITDONE;
		sm->Pair = true;
		return 0;
	}
#endif /* CONFIG_FILS */

	if (sm->started) {
		os_memset(&sm->key_replay, 0, sizeof(sm->key_replay));
		sm->ReAuthenticationRequest = true;
		return wpa_sm_step(sm);
	}

	wpa_auth_logger(wpa_auth, wpa_auth_get_spa(sm), LOGGER_DEBUG,
			"start authentication");
	sm->started = 1;

	sm->Init = true;
	if (wpa_sm_step(sm) == 1)
		return 1; /* should not really happen */
	sm->Init = false;

	if (wpa_auth_4way_handshake_offload(sm->wpa_auth))
		wpa_auth_logger(wpa_auth, sm->addr, LOGGER_DEBUG,
				"Skip EAPOL for 4-way handshake offload case");
	else
		sm->AuthenticationRequest = true;

	return wpa_sm_step(sm);
}
```

5.2. WPA 상태 머신 단계 처리
함수: wpa_sm_step()
위치: wpa_auth.c
설명: WPA 상태 머신의 한 단계를 처리하는 함수

매개변수:
- sm: struct wpa_state_machine * - WPA 상태 머신

반환값:
- int - 상태 머신 진행 결과

5.3. Association 완료 시 호출
위치: hostapd.c:4184
설명: Association이 완료된 후 호출되는 지점

주요 로직:
```4184:4184:hostap/src/ap/hostapd.c
		wpa_auth_sta_associated(hapd->wpa_auth, sta->wpa_sm);
```

5.4. EAPOL Key Frame 전송 트리거
설명: sm->AuthenticationRequest가 true로 설정되면, wpa_sm_step() 내부에서
EAPOL Key Frame을 전송하여 4-way handshake를 시작합니다.

상수:
- WPA_PTK_INITIALIZE: PTK 초기화 상태
- WPA_PTK_START: PTK 시작 상태
- WPA_PTK_PTKINITNEGOTIATING: PTK 협상 중 상태
- WPA_PTK_PTKINITDONE: PTK 초기화 완료 상태

5.5. EAPOL 인증 상태 머신 (AP 측)
파일: hostap/src/eapol_auth/eapol_auth_sm.c

함수: SM_STEP(AUTH_PAE)
위치: eapol_auth_sm.c:390-451
설명: EAPOL 인증 상태 머신의 단계 처리

주요 로직:
```390:451:hostap/src/eapol_auth/eapol_auth_sm.c
SM_STEP(AUTH_PAE)
{
	if ((sm->portControl == Auto && sm->portMode != sm->portControl) ||
	    sm->initialize || !sm->eap_if->portEnabled)
		SM_ENTER_GLOBAL(AUTH_PAE, INITIALIZE);
	else if (sm->portControl == ForceAuthorized &&
		 sm->portMode != sm->portControl &&
		 !(sm->initialize || !sm->eap_if->portEnabled))
		SM_ENTER_GLOBAL(AUTH_PAE, FORCE_AUTH);
	else if (sm->portControl == ForceUnauthorized &&
		 sm->portMode != sm->portControl &&
		 !(sm->initialize || !sm->eap_if->portEnabled))
		SM_ENTER_GLOBAL(AUTH_PAE, FORCE_UNAUTH);
	else {
		switch (sm->auth_pae_state) {
		case AUTH_PAE_INITIALIZE:
			SM_ENTER(AUTH_PAE, DISCONNECTED);
			break;
		case AUTH_PAE_DISCONNECTED:
			if (!sm->stopped)
				SM_ENTER(AUTH_PAE, RESTART);
			break;
		case AUTH_PAE_RESTART:
			if (!sm->eap_if->eapRestart)
				SM_ENTER(AUTH_PAE, CONNECTING);
			break;
		case AUTH_PAE_CONNECTING:
			if (sm->eapolLogoff || sm->reAuthCount > sm->reAuthMax)
				SM_ENTER(AUTH_PAE, DISCONNECTED);
			else if ((sm->eap_if->eapReq &&
				  sm->reAuthCount <= sm->reAuthMax) ||
				 sm->eap_if->eapSuccess || sm->eap_if->eapFail)
				SM_ENTER(AUTH_PAE, AUTHENTICATING);
			break;
		case AUTH_PAE_AUTHENTICATED:
			if (sm->eapolStart || sm->reAuthenticate)
				SM_ENTER(AUTH_PAE, RESTART);
			else if (sm->eapolLogoff || !sm->portValid)
				SM_ENTER(AUTH_PAE, DISCONNECTED);
			break;
		case AUTH_PAE_AUTHENTICATING:
			if (sm->authSuccess && sm->portValid)
				SM_ENTER(AUTH_PAE, AUTHENTICATED);
			else if (sm->authFail ||
				 (sm->keyDone && !sm->portValid))
				SM_ENTER(AUTH_PAE, HELD);
			else if (sm->eapolStart || sm->eapolLogoff ||
				 sm->authTimeout)
				SM_ENTER(AUTH_PAE, ABORTING);
			break;
		}
	}
}
```

================================================================================
요약
================================================================================

WPA3 SAE 프로세스의 주요 흐름:

1. Beacon Frame 전송:
   - ieee802_11_set_beacon() -> hostapd_get_rsne() -> wpa_auth_get_wpa_ie()
   - RSNE와 RSNXE에 SAE 키 관리 방법 포함

2. Authentication 시작:
   - handle_auth() -> handle_auth_sae() -> sae_sm_step()
   - auth_transaction == 1: Commit 메시지 교환
   - auth_transaction == 2: Confirm 메시지 교환

3. Association 처리:
   - handle_assoc() -> wpa_auth_sta_associated()
   - SAE 인증 완료 후 Association 허용

4. 키 연산:
   - sae_process_commit() -> sae_derive_k_ecc()/sae_derive_k_ffc()
   - sae_derive_keys() -> sae_kdf_hash()
   - KCK, PMK, PMKID 도출

5. EAPOL 4-way Handshake:
   - wpa_auth_sta_associated() -> wpa_sm_step()
   - EAPOL Key Frame을 통한 PTK 협상

================================================================================

